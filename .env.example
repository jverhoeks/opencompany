OPENAI_API_KEY=your-litellm-proxy-key
OPENAI_API_BASE=https://your-litellm-proxy.example.com
LITELLM_MODEL_ID=azure/gpt-5

DATABASE_URL=postgresql+asyncpg://opencompany:opencompany@localhost:5432/opencompany
REDIS_URL=redis://localhost:6379/0

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# CEO auto-kickoff (0 = disabled, e.g. 300 = every 5 minutes)
CEO_KICKOFF_INTERVAL_SECONDS=0
# Optional: override the CEO kickoff prompt
# CEO_KICKOFF_PROMPT=Review the board and take action.

# API authentication (empty = auth disabled in dev)
API_KEY=
